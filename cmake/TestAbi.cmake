cmake_minimum_required(VERSION 3.16)
execute_process(COMMAND "${NM}" -D --defined-only "${LIBRARY}"
    RESULT_VARIABLE status OUTPUT_VARIABLE symbols ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "nm failed: ${errors}")
endif()
file(READ "${MAP}" exports)
string(REGEX MATCHALL "rc_[a-z_]+" expected "${exports}")
string(REPLACE "\n" ";" lines "${symbols}")
set(actual)
foreach(line IN LISTS lines)
    if(line STREQUAL "")
        continue()
    endif()
    if(NOT line MATCHES " T (rc_[a-z_]+)$")
        message(FATAL_ERROR "Unexpected exported symbol: ${line}")
    endif()
    list(APPEND actual "${CMAKE_MATCH_1}")
endforeach()
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Export mismatch: ${actual}; expected ${expected}")
endif()
execute_process(COMMAND "${READELF}" -d "${LIBRARY}"
    RESULT_VARIABLE status OUTPUT_VARIABLE dynamic ERROR_VARIABLE errors)
if(NOT status EQUAL 0 OR NOT dynamic MATCHES "SONAME[^\n]*\\[${SONAME}\\]")
    message(FATAL_ERROR "Wrong SONAME: ${dynamic} ${errors}")
endif()
